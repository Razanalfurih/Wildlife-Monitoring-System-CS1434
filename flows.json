    {
        "id": "fb28aaacaf1e6b78",
        "type": "function",
        "z": "bdd7f3f23f742317",
        "name": "Check Alerts",
        "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\nlet status = \"STABLE\";\nlet alert = \"All conditions are safe.\";\n\nif (data.temperature > 45) {\n    status = \"CRITICAL\";\n    alert = \"CRITICAL: Temperature above 45°C!\";\n}\nelse if (data.temperature > 42) {\n    status = \"WARNING\";\n    alert = \"WARNING: Temperature above 42°C.\";\n}\n\nif (data.water_level === \"empty\") {\n    status = \"CRITICAL\";\n    alert = \"CRITICAL: Water tank is empty!\";\n}\nelse if (data.water_level === \"low\" && status !== \"CRITICAL\") {\n    status = \"WARNING\";\n    alert = \"WARNING: Water level is low.\";\n}\n\nif (data.type === \"intruder\") {\n    status = \"CRITICAL\";\n    alert = \"CRITICAL: Intruder detected!\";\n}\n\nmsg.payload = {\n    zone: data.zone,\n    species: data.species,\n    temperature: data.temperature,\n    water_level: data.water_level,\n    motion: data.motion,\n    type: data.type,\n    status: status,\n    alert: alert\n};\n\nreturn msg;",
